  object TMSMCPCloudAI1: TTMSMCPCloudAI
    Service = aiOpenAI
    Settings.GeminiModel = 'gemini-2.5-flash'
    Settings.OpenAIModel = 'gpt-5.4-mini-2026-03-17'
    Settings.OpenAISoundModel = 'gpt-4o-mini-tts'
    Settings.OpenAITranscribeModel = 'whisper-1'
    Settings.OpenRouterModel = 'z-ai/glm-5.3-flash'
    Settings.GrokModel = 'grok-4-1-fast-reasoning'
    Settings.ClaudeModel = 'claude-sonnet-4-6'
    Settings.OllamaModel = 'llama3.2:latest'
    Settings.DeepSeekModel = 'deepseek-chat'
    Settings.PerplexityModel = 'sonar-pro'
    Settings.OllamaHost = 'localhost'
    Settings.OllamaPath = '/api/chat'
    Settings.LlamaCppHost = 'localhost'
    Settings.LlamaCppPath = '/v1/chat/completions'
    Settings.MistralModel = 'mistral-large-latest'
    Settings.MistralTranscribeModel = 'voxtral-mini-2507'
    Tools = <
      item
        Name = 'get_schedule'
        Description = 
          'Read the live Planner: demo date, resource IDs and roles, workin' +
          'g hours, and all appointments including current selection and lo' +
          'cked lunch breaks. Call at the start of each scheduling request;' +
          ' manual drag and resize changes are live.'
        Parameters = <>
        OnExecute = PlannerToolExecute
      end
      item
        Name = 'find_free_slots'
        Description = 
          'Find free slots for ALL listed resources together. Pass one ID f' +
          'or one person, several IDs for a meeting. Returns found, chronol' +
          'ogical slots, earliest_slot (null when none), and longest_common' +
          '_free_minutes. Do not invent a time when found=false. Read-only;' +
          ' does not move or book work.'
        Parameters = <
          item
            ArrayProperties = <>
            Name = 'resource_ids'
            Type = ptArray
            Description = 
              'Nonempty list of resource IDs from get_schedule. For everyone, i' +
              'nclude ALL resources.'
            Properties = <>
          end
          item
            ArrayProperties = <>
            Name = 'duration_minutes'
            Type = ptNumber
            Description = 
              'Meeting duration supplied by the user: integer 15 to 480, divisi' +
              'ble by 15. Ask if unknown.'
            Properties = <>
          end
          item
            ArrayProperties = <>
            Name = 'earliest'
            Type = ptString
            Description = 'Earliest start HH:MM; use 09:00 when searching the whole day'
            Properties = <>
          end
          item
            ArrayProperties = <>
            Name = 'latest'
            Type = ptString
            Description = 'Latest end HH:MM; use 18:00 when searching the whole day'
            Properties = <>
          end>
        OnExecute = PlannerToolExecute
      end
      item
        Name = 'create_appointment'
        Description = 
          'Book work for one resource. Rejects overlaps, lunch, invalid tim' +
          'es, and appointments outside 09:00-18:00. Returns the new appoin' +
          'tment.'
        Parameters = <
          item
            ArrayProperties = <>
            Name = 'title'
            Type = ptString
            Description = 'Appointment title, 1 to 120 characters'
            Properties = <>
          end
          item
            ArrayProperties = <>
            Name = 'resource_id'
            Type = ptString
            Description = 'Resource ID from get_schedule'
            Properties = <>
          end
          item
            ArrayProperties = <>
            Name = 'start_time'
            Type = ptString
            Description = 'Start HH:MM, on a 15-minute boundary'
            Properties = <>
          end
          item
            ArrayProperties = <>
            Name = 'end_time'
            Type = ptString
            Description = 'End HH:MM, on a 15-minute boundary'
            Properties = <>
          end
          item
            ArrayProperties = <>
            Name = 'notes'
            Type = ptString
            Description = 
              'Optional details as a string; use empty string for none, maximum' +
              ' 1000 characters'
            Properties = <>
          end>
        OnExecute = PlannerToolExecute
      end
      item
        Name = 'reschedule_appointments'
        Description = 
          'Move or resize one or more existing appointments as one atomic c' +
          'hange. Delphi validates the FINAL schedule before changing anyth' +
          'ing. Use this for overruns, swaps and replanning; include every ' +
          'affected appointment. When the user asks to rearrange a person'#39's' +
          ' afternoon, moving that person'#39's other nonlocked afternoon appoi' +
          'ntments is already authorized. Extend the target by the requeste' +
          'd amount and move later appointments as needed. Preserve OTHER a' +
          'ppointments'#39' durations and assignees. Locked lunch cannot move. ' +
          'Temporary overlaps do not matter; only the final schedule must b' +
          'e conflict-free. If validation fails, revise the complete plan a' +
          'nd retry.'
        Parameters = <
          item
            ArrayType = ptObject
            ArrayProperties = <
              item
                ArrayProperties = <>
                Name = 'appointment_id'
                Type = ptString
                Description = 'Stable ID from get_schedule'
                Properties = <>
              end
              item
                ArrayProperties = <>
                Name = 'resource_id'
                Type = ptString
                Description = 'Keep the original resource unless reassignment was requested'
                Properties = <>
              end
              item
                ArrayProperties = <>
                Name = 'start_time'
                Type = ptString
                Description = 
                  'Final start HH:MM. Keep the target start when extending an overr' +
                  'un.'
                Properties = <>
              end
              item
                ArrayProperties = <>
                Name = 'end_time'
                Type = ptString
                Description = 
                  'Final end HH:MM. Extend the target; preserve durations of other ' +
                  'moved work.'
                Properties = <>
              end>
            Name = 'changes'
            Type = ptArray
            Description = 
              'Complete final placements for ALL affected appointments, includi' +
              'ng the extended target and other appointments that must move. Cu' +
              'rrent IDs only. Unlisted appointments keep their existing placem' +
              'ent.'
            Properties = <>
          end>
        OnExecute = PlannerToolExecute
      end>
    Left = 704
    Top = 32
  end
end
