<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{80C879A5-0D89-4010-BE69-249447DC73B4}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="TextToImage.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="RemoveBackground.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="ChangeText.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="TextToImage">
        <MSBuild Projects="TextToImage.dproj"/>
    </Target>
    <Target Name="TextToImage:Clean">
        <MSBuild Projects="TextToImage.dproj" Targets="Clean"/>
    </Target>
    <Target Name="TextToImage:Make">
        <MSBuild Projects="TextToImage.dproj" Targets="Make"/>
    </Target>
    <Target Name="RemoveBackground">
        <MSBuild Projects="RemoveBackground.dproj"/>
    </Target>
    <Target Name="RemoveBackground:Clean">
        <MSBuild Projects="RemoveBackground.dproj" Targets="Clean"/>
    </Target>
    <Target Name="RemoveBackground:Make">
        <MSBuild Projects="RemoveBackground.dproj" Targets="Make"/>
    </Target>
    <Target Name="ChangeText">
        <MSBuild Projects="ChangeText.dproj"/>
    </Target>
    <Target Name="ChangeText:Clean">
        <MSBuild Projects="ChangeText.dproj" Targets="Clean"/>
    </Target>
    <Target Name="ChangeText:Make">
        <MSBuild Projects="ChangeText.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="TextToImage;RemoveBackground;ChangeText"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="TextToImage:Clean;RemoveBackground:Clean;ChangeText:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="TextToImage:Make;RemoveBackground:Make;ChangeText:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
